@page
@model t4_pr1_JhonOsorio29.Pages.WaterConsumModel
<div class="container">
    <h1>Consumo de Agua</h1>

    <!-- Botón para mostrar/ocultar el formulario -->
    <button id="mostrarFormulario" class="btn btn-primary">Añadir Consumo de Agua</button>

    <!-- Formulario para añadir datos de WaterConsumption -->
    <form method="post" class="mt-3" id="formularioConsumo" style="display:none;">
        <div class="mb-3">
            <label for="Year" class="form-label">Año</label>
            <input type="number" class="form-control" id="Year" asp-for="NewWaterConsumption.Year" required>
        </div>
        <div class="mb-3">
            <label for="ComarcaCode" class="form-label">Código de Comarca</label>
            <input type="text" class="form-control" id="ComarcaCode" asp-for="NewWaterConsumption.ComarcaCode" required>
        </div>
        <div class="mb-3">
            <label for="Comarca" class="form-label">Comarca</label>
            <input type="text" class="form-control" id="Comarca" asp-for="NewWaterConsumption.Comarca" required>
        </div>
        <div class="mb-3">
            <label for="Population" class="form-label">Población</label>
            <input type="number" class="form-control" id="Population" asp-for="NewWaterConsumption.Population" required>
        </div>
        <div class="mb-3">
            <label for="DomesticConsumption" class="form-label">Consumo Doméstico</label>
            <input type="number" class="form-control" id="DomesticConsumption" asp-for="NewWaterConsumption.DomesticConsumption" required>
        </div>
        <div class="mb-3">
            <label for="EconomicConsumption" class="form-label">Consumo Económico</label>
            <input type="number" class="form-control" id="EconomicConsumption" asp-for="NewWaterConsumption.EconomicConsumption" required>
        </div>
        <div class="mb-3">
            <label for="TotalConsumption" class="form-label">Consumo Total</label>
            <input type="number" class="form-control" id="TotalConsumption" asp-for="NewWaterConsumption.TotalConsumption" required>
        </div>
        <div class="mb-3">
            <label for="PerCapitaConsumption" class="form-label">Consumo por Cápita</label>
            <input type="number" class="form-control" id="PerCapitaConsumption" asp-for="NewWaterConsumption.PerCapitaConsumption" required>
        </div>
        <button type="submit" class="btn btn-success">Guardar Consumo</button>
    </form>
    <h2>Datos Guardados</h2>
    @if (Model.WaterConsumptions.Any())
    {
        <table class="table table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th>Año</th>
                    <th>Código de Comarca</th>
                    <th>Comarca</th>
                    <th>Población</th>
                    <th>Consumo Doméstico</th>
                    <th>Consumo Económico</th>
                    <th>Consumo Total</th>
                    <th>Consumo por Cápita</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.WaterConsumptions)
                {
                    <tr>
                        <td>@item.Year</td>
                        <td>@item.ComarcaCode</td>
                        <td>@item.Comarca</td>
                        <td>@item.Population</td>
                        <td>@item.DomesticConsumption</td>
                        <td>@item.EconomicConsumption</td>
                        <td>@item.TotalConsumption</td>
                        <td>@item.PerCapitaConsumption</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No hay datos guardados.</p>
    }


    <!-- Script para mostrar/ocultar el formulario -->
    <script>
        document.getElementById('mostrarFormulario').addEventListener('click', function () {
            var formulario = document.getElementById('formularioConsumo');
            if (formulario.style.display === 'none') {
                formulario.style.display = 'block';
            } else {
                formulario.style.display = 'none';
            }
        });
    </script>

</div>

<h1>Consumo de Agua</h1>

<h2>1️. 10 municipios con mayor consumo de agua en el año más reciente</h2>
<table class="table table-striped table-hover table-bordered">
    <tr><th>Municipio</th><th>Año</th><th>Consumo Total (m³)</th></tr>
    @foreach (var item in Model.TopMunicipalities)
    {
        <tr>
            <td>@item.Comarca</td>
            <td>@item.Year</td>
            <td>@item.TotalConsumption</td>
        </tr>
    }
</table>

<h2>2️. Consumo medio por comarca</h2>
<table class="table table-striped table-hover table-bordered">
    <tr><th>Comarca</th><th>Consumo Medio (m³)</th></tr>
    @foreach (var item in Model.AvgComarcaConsumption)
    {
        <tr>
            <td>@item.Comarca</td>
            <td>@item.AvgConsumption</td>
        </tr>
    }
</table>

<h3>Consumos Sospechosos</h3>
@if (Model.SuspiciousConsumptions.Any())
{
    <table class="table table-striped table-hover table-bordered">
        @for (int i = 0; i < Model.SuspiciousConsumptions.Count; i += 3)
        {
            <tr>
                @for (int j = i; j < i + 3 && j < Model.SuspiciousConsumptions.Count; j++)
                {
                    <td>@Model.SuspiciousConsumptions[j]</td>
                }
            </tr>
        }
    </table>
}
else
{
    <p>No se encontraron consumos sospechosos.</p>
}

<h2>4️. Municipios con tendencia creciente en los últimos 5 años</h2>
<table class="table table-striped table-hover table-bordered">
        @foreach (var item in Model.IncreasingTrendMunicipalities)
        {
            <tr>
            <td>@item</td>
            </tr>
        }
</table>